apps/yral-ios/iosApp.xcodeproj/xcuserdata/
apps/yral-ios/iosApp.xcodeproj/project.xcworkspace/xcuserdata/

# cargo-leptos regenerates this at the repo root on every build (a repo-root
# relative copy of the per-app configs). Deliberately removed in 404720d6; the
# build recreates it, so ignore it rather than re-commit it on every Leptos build.
/tailwind.config.js

