FROM docker.io/node:26.13.1-bookworm-slim AS builder

WORKDIR /app
COPY apps/my-website/package.json apps/my-website/package-lock.json ./
RUN npm ci
COPY apps/my-website/ ./
RUN npm run check && npm test && npm run build
RUN npm prune --omit=dev

FROM docker.io/node:26.13.1-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
ENV ORIGIN=https://saikat.dev
COPY --from=builder --chown=node:node /app/package.json ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/build ./build
USER node
EXPOSE 8080
CMD ["node", "build"]
