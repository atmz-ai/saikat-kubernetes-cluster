# Managed by Ansible (role: beszel-agent). Do not edit on the host.
#
# Reference: https://beszel.dev/guide/environment-variables
#
# TOKEN is the hub's universal token (/settings/tokens), which lets an agent
# self-register without a per-system entry. This file is mode 0600 owned by root
# because of it.
LISTEN={{ beszel_listen_port }}
KEY="{{ beszel_ssh_key }}"
HUB_URL={{ beszel_hub_url }}
TOKEN={{ beszel_agent_token }}
