{{ ansible_managed | comment }}
# DNSEndpoint resources for {{ pdns_zone_name }} — generated by ansible/roles/pdns-zones from the inventory.
#
# Source of truth: ansible/inventory/00-hosts.yml
#   - Workers with `namecheap_nameserver` annotation → NS glue records
#   - All nodes (workers + control planes) → wildcard
#
# The BARE APEX is NOT here — pdns-apex-records.yaml owns it, applied with pdnsutil,
# because external-dns cannot own an apex record (upstream #6125). The apex A records
# and the apex NS records both live there.
#
# Synced to PowerDNS by ExternalDNS via RFC2136 dynamic updates.
#
# The zone itself is NOT created by this file. The only resource here is the
# DNSEndpoint CRD, and ExternalDNS never creates zones — it manages records within
# an existing one. Zone infrastructure (zone, SOA, TSIG key, metadata) is created by
# the pdns-db-seed Job:
#   kubernetes/infrastructure/external-dns/pdns-db-seed.yaml
# A new zone must be named in that Job's script before these records can be written,
# and the zone must also be added to external-dns's --rfc2136-zone/--domain-filter
# flags (both repeatable). See that file and external-dns-deployment.yaml.
#
# To regenerate after node changes (regenerates EVERY zone):
#   mise run dns-generate
---
apiVersion: externaldns.k8s.io/v1alpha1
kind: DNSEndpoint
metadata:
  name: {{ pdns_zone_name | replace('.', '-') }}-nameserver-a
  namespace: external-dns
spec:
  endpoints:
    # Glue records — nameserver IPs (must match Namecheap glue records + pdns-service-dns externalIPs)
    # These IPs come from 00-hosts.yml (the nodes annotated with namecheap_nameserver)
{% for ns in pdns_nameservers %}
    - dnsName: {{ ns.prefix }}.{{ pdns_zone_name }}
      recordTTL: 300
      recordType: A
      targets:
        - {{ ns.ip }}
{% endfor %}
---
apiVersion: externaldns.k8s.io/v1alpha1
kind: DNSEndpoint
metadata:
  name: {{ pdns_zone_name | replace('.', '-') }}-app-a
  namespace: external-dns
spec:
  endpoints:
    # ! WILDCARD ONLY. The BARE APEX deliberately lives in pdns-apex-records.yaml
    # ! instead, applied with pdnsutil: external-dns never writes an ownership marker
    # ! for an apex record, so plan.go drops the apex from both creates and updates
    # ! and it can never be converged from here (upstream #6125). Declaring it here as
    # ! well would be a second declaration of the same record that nothing acts on.
    #
    # * The DNSEndpoint name keeps its `-app-a` suffix even though it no longer holds
    # * the apex: external-dns's ownership markers already written into the zone name
    # * `resource=crd/.../{{ pdns_zone_name | replace('.', '-') }}-app-a`, so renaming
    # * it would orphan the wildcard's marker and the wildcard would fall unowned.
    #
    # * Wildcard → ALL node IPs (workers + control planes). Any request hitting any
    # * node is routed by the Cilium mesh to whichever node hosts the destination pod.
    # * No per-service routing. Regenerated from the inventory on every node playbook.
    - dnsName: "*.{{ pdns_zone_name }}"
      recordTTL: 300
      recordType: A
      targets:
{% for ip in pdns_all_node_ips %}
        - {{ ip }}
{% endfor %}
{% if pdns_zone_endpoint_names %}
---
apiVersion: externaldns.k8s.io/v1alpha1
kind: DNSEndpoint
metadata:
  name: {{ pdns_zone_name | replace('.', '-') }}-control-plane-endpoint
  namespace: external-dns
spec:
  endpoints:
    # ! Publish only after serving certificates match the declared SANs.
    # ! API records use control planes only; wildcard worker targets cannot serve :6443.
{% for endpoint_name in pdns_zone_endpoint_names %}
    - dnsName: {{ endpoint_name }}
      recordTTL: 300
      recordType: A
      targets:
{% for ip in pdns_control_plane_ips %}
        - {{ ip }}
{% endfor %}
{% endfor %}
{% endif %}