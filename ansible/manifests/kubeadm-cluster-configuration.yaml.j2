apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
# Shared kubeadm ClusterConfiguration template — the single declarative source
# of truth for the cluster. Consumed by:
#   - ansible/roles/cluster-init (renders at bootstrap, passes to kubeadm init --config)
#   - ansible/roles/control-plane-join (renders on an existing CP node and uploads
#     the ConfigMap before a join, since a joining node downloads its config from
#     that ConfigMap rather than reading a file)
#   - ansible/roles/control-plane-metrics (renders on existing CP nodes, reconciles
#     static pod manifests + the kubeadm-config ConfigMap)
#   - ansible/roles/control-plane-certificates (renders on existing CP nodes,
#     regenerates the apiserver serving certificate when its SANs have changed)
# Never patch the kubeadm-config ConfigMap directly — kubeadm generates static
# pod manifests from this config only at init/join/upgrade time, and ConfigMap
# edits do NOT propagate to existing manifests.
#
# WHAT CHANGING A VALUE HERE DOES AND DOES NOT AFFECT — the answer differs by
# whether the node already exists, which is the single most misleading thing about
# this file:
#   - NEW nodes (init/join) build their components from this config at the moment
#     they join, so a change here reaches them automatically.
#   - EXISTING nodes do NOT converge. A ConfigMap edit reaches no running pod, and
#     for apiServer.certSANs specifically it cannot: a SAN lives in the certificate,
#     which kubeadm only writes at init/join time. Every existing node therefore
#     needs a reconcile playbook — reconcile-control-plane-metrics.yml for component
#     args, reconcile-control-plane-certificates.yml for SANs.
#
# The extraArgs below fix control-plane metrics scrape failures (TargetDown /
# etcdMembersDown / etcdInsufficientMembers alerts):
#   - kube-controller-manager and kube-scheduler bind their metrics endpoints
#     to loopback by default; nodes only have public IPs (no private LAN),
#     so Prometheus (on a worker) must scrape via the public interface.
#     bind-address=0.0.0.0 matches the kubelet :10250 posture: delegated
#     authentication + authorization — the Prometheus service account is
#     authorized (RBAC verified), anonymous callers are rejected.
#   - etcd is NOT opened further: Prometheus scrapes the existing
#     mTLS-protected client port :2379 (see kubernetes/infrastructure/monitoring/
#     helmrelease.yaml kubeEtcd section). The loopback-only :2381 metrics port
#     is intentionally left at kubeadm defaults (unused).
kubernetesVersion: v{{ kubernetes_version }}
controlPlaneEndpoint: "{{ control_plane_endpoint }}:6443"
networking:
  podSubnet: {{ pod_network_cidr }}
  serviceSubnet: 10.96.0.0/12
  dnsDomain: cluster.local
clusterName: kubernetes
certificatesDir: /etc/kubernetes/pki
imageRepository: registry.k8s.io
encryptionAlgorithm: RSA-2048
# kube-proxy is replaced by Cilium (kubeProxyReplacement: true).
proxy:
  disabled: true
apiServer:
  # Additional Subject Alternative Names for the kube-apiserver serving certificate,
  # beyond what kubeadm derives from controlPlaneEndpoint and the node name/IP.
  # Sourced from `api_server_cert_sans` in ansible/inventory/hosts.yml.
  #
  # ADDING A NAME HERE DOES NOT ADD IT TO A CERTIFICATE THAT ALREADY EXISTS. The
  # certificate is the gate — a name absent from it fails TLS verification, which
  # loses all control-plane access even though the API itself is healthy — and
  # kubeadm will not converge it from this file. Regeneration is a separate
  # per-node PKI operation; see the control-plane-certificates role, which performs
  # it and documents the two ways kubeadm silently declines to.
  #
  # Emitted as an empty list rather than omitted when the variable is unset, so this
  # file stays valid YAML for `kubeadm config` parsing. kubeadm treats an empty
  # certSANs the same as an absent one, so the fallback cannot change cluster
  # behaviour.
  certSANs:
{% for subject_alternative_name in api_server_cert_sans | default([], true) %}
    - {{ subject_alternative_name }}
{% endfor %}
  extraArgs:
    - name: service-node-port-range
      value: "{{ service_node_port_range }}"
controllerManager:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
scheduler:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
etcd:
  local:
    dataDir: /var/lib/etcd
    # Bind etcd's listeners to 0.0.0.0 while it CONTINUES TO ADVERTISE this node's
    # concrete address (advertise-client-urls / initial-advertise-peer-urls are
    # still derived from AdvertiseAddress and are unchanged).
    #
    # WHY: kubeadm derives etcd's BIND and ADVERTISE addresses from the SAME value
    # — `getEtcdCommand` sets both `listen-*-urls` and `*-advertise-*-urls` from
    # `endpoint.AdvertiseAddress` — and there is no kubeadm field for a separate
    # bind address (LocalEtcd exposes only dataDir/extraArgs/extraEnvs/certSANs).
    # So a node that must advertise an address that is NOT on one of its interfaces
    # gets a manifest etcd cannot start:
    #
    #     --listen-peer-urls=https://<public>:2380
    #     {"level":"error","msg":"creating peer listener failed",
    #      "error":"listen tcp <public>:2380: bind: cannot assign requested address"}
    #
    # That is the case on a NAT'd cloud VM, where the public IP is attached to the
    # NIC by the provider and appears on no interface (Azure DNATs inbound traffic
    # to the private address before the VM sees it, so the public address can never
    # be bound — Microsoft's docs prohibit adding it to the OS). The etcd container
    # never starts, yet kubeadm has already registered the member, so the join fails
    # at `etcd-join` with "the etcd member <id> is not started" and leaves a phantom
    # unstarted learner behind.
    #
    # 0.0.0.0 is correct for EVERY provider, which is why this belongs here in the
    # cluster-wide config rather than in a per-node patch: it covers the public IP on
    # a bare-metal node (where the public IP is on the interface) and the private
    # address on a NAT'd VM (the interface address), so no node needs a different
    # value and there is nothing to keep in per-node sync.
    #
    # This does NOT widen exposure. etcd already advertises and serves on the node's
    # public address over mTLS with client-cert-auth on both the peer and client
    # ports; 0.0.0.0 only adds coverage of the second interface on a multi-homed host.
    #
    # It also does not need a certificate change: TLS validates the address a client
    # DIALS (the advertised public address, already in the certs), not the address the
    # server BINDS.
    #
    # Setting an extraArg REPLACES kubeadm's generated argument of the same name
    # (see ArgumentsToCommand: an override with no merge method drops the base arg and
    # is appended as `--name=value`), so these do not end up duplicated. That makes
    # this the supported mechanism for this change — unlike editing the generated
    # manifest, which would depend on the argument's position in an alphabetically
    # sorted list.
    #
    # listen-client-urls is 0.0.0.0 ALONE, deliberately NOT prepended with
    # 127.0.0.1. kubeadm's generated value is "127.0.0.1,<advertise>" precisely
    # because it names each address separately, but 0.0.0.0 already covers every
    # local address INCLUDING loopback — so listing 127.0.0.1 alongside it makes
    # etcd bind the same socket twice and refuse to start:
    #
    #     msg="closing peer listener","address":"0.0.0.0:2379",
    #     error="listen tcp 127.0.0.1:2379: bind: address already in use"
    #
    # The local apiserver reaches etcd at 127.0.0.1:2379 either way: it connects to
    # a loopback destination and 0.0.0.0 accepts it.
    extraArgs:
      - name: listen-peer-urls
        value: https://0.0.0.0:2380
      - name: listen-client-urls
        value: https://0.0.0.0:2379