apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
# Single declarative source of truth for the cluster, rendered by:
#   - cluster-init (bootstrap, passed to kubeadm init --config)
#   - control-plane-join (uploaded to the kubeadm-config ConfigMap before a join,
#     which is where a joining node reads it from)
#   - control-plane-metrics / control-plane-certificates (reconcile existing nodes)
#
# WARNING: kubeadm writes static pod manifests from this config only at
# init/join/upgrade time, so a change here does NOT reach an existing node — a
# ConfigMap edit reaches no running pod. Existing nodes converge only via the
# reconcile playbooks (see AGENTS.md). Never edit the ConfigMap directly.
kubernetesVersion: v{{ kubernetes_version }}
controlPlaneEndpoint: "{{ control_plane_endpoint }}:6443"
networking:
  podSubnet: {{ pod_network_cidr }}
  serviceSubnet: 10.96.0.0/12
  dnsDomain: cluster.local
clusterName: kubernetes
certificatesDir: /etc/kubernetes/pki
imageRepository: registry.k8s.io
encryptionAlgorithm: RSA-2048
# kube-proxy is replaced by Cilium (kubeProxyReplacement: true).
proxy:
  disabled: true
apiServer:
  # Additional SANs for the apiserver serving certificate, beyond what kubeadm
  # derives from controlPlaneEndpoint. Sourced from `api_server_cert_sans`.
  #
  # WARNING: the certificate is written only at init/join time, so adding a name
  # here does not add it to an existing certificate — and a name absent from the
  # certificate fails TLS verification, losing control-plane access while the API
  # stays healthy. Existing nodes need reconcile-control-plane-certificates.yml.
  # Adding a SAN must be ADDITIVE: carry old and new names together.
  #
  # Emitted as an empty list rather than omitted when the variable is unset, so this
  # file stays valid YAML for `kubeadm config` parsing. kubeadm treats an empty
  # certSANs the same as an absent one, so the fallback cannot change cluster
  # behaviour.
  certSANs:
{% for subject_alternative_name in api_server_cert_sans | default([], true) %}
    - {{ subject_alternative_name }}
{% endfor %}
  extraArgs:
    - name: service-node-port-range
      value: "{{ service_node_port_range }}"
controllerManager:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
scheduler:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
etcd:
  local:
    dataDir: /var/lib/etcd
    # WARNING: exactly ONE `extraArgs:` mapping. A second REPLACES the first (YAML
    # keeps the last duplicate key) rather than merging — that happened here, so the
    # listen URLs were silently dropped and nodes bound the generated
    # `https://<public>:2380`. Harmless on Hetzner, `bind: cannot assign requested
    # address` on a NAT'd cloud VM, whose advertised address is on no interface.
    #
    # listen-client-urls is 0.0.0.0 ALONE — adding 127.0.0.1 makes etcd bind the same
    # socket twice and refuse to start.
    #
    # Timeouts must be IDENTICAL on every member (etcd.io/docs/v3.6/tuning), so they
    # are cluster-wide. Sized for the slowest member: measured RTT is 127-148ms to
    # Central India against 36ms between the Hetzner DCs, above the 100ms/1000ms
    # defaults. Cost: up to 2.5s to detect a dead leader.
    #
    # WARNING: existing members do NOT pick this up (manifests are written only at
    # init/join time) — they need reconcile-control-plane-metrics.yml. The upload to
    # the kubeadm-config ConfigMap must happen BEFORE a join.
    extraArgs:
      - name: listen-peer-urls
        value: https://0.0.0.0:2380
      - name: listen-client-urls
        value: https://0.0.0.0:2379
      - name: heartbeat-interval
        value: "{{ etcd_heartbeat_interval_milliseconds }}"
      - name: election-timeout
        value: "{{ etcd_election_timeout_milliseconds }}"
    # Extra Subject Alternative Names for the etcd SERVER certificate.
    #
    # WHY: the etcd static pods are hostNetwork, so their client URL binds the NODE's
    # address — and Prometheus reaches them through a Service whose endpoints are the
    # nodes' InternalIPs. kubeadm puts the node's ADVERTISE address in the generated
    # certificate, and a NAT'd cloud VM advertises its ROUTABLE (public) address, so the
    # private address a scrape actually dials is absent and every target fails
    # verification:
    #
    #   x509: certificate is valid for 20.219.32.205, 127.0.0.1, ::1, not 172.16.0.4
    #
    # which surfaces as TargetDown + etcdMembersDown ("members are down (3)") +
    # etcdInsufficientMembers ("insufficient members (0)") on a cluster whose etcd is
    # entirely healthy — the alerts describe a broken SCRAPE, not a broken etcd.
    #
    # BOTH ADDRESSES PER NODE, AND THAT IS LOAD-BEARING — not belt-and-braces. kubeadm
    # regenerates the certificate from THIS CONFIG ALONE, and the advertise address is
    # NOT in it: kubeadm takes it from the join command's --apiserver-advertise-address
    # flag. So a private-address-only list REPLACES the advertise address rather than
    # adding to it, and every client that dials the public address breaks:
    #
    #   x509: certificate is valid for 172.16.0.4, ..., not 20.219.32.205
    #
    # That is not hypothetical — it is exactly what a private-only list did here
    # (measured 2026-10-09), and it broke the etcd rollout's own
    # `etcdctl endpoint health --cluster`, which reaches members on their ADVERTISED
    # public client URLs. Adding a SAN must be ADDITIVE (AGENTS.md): carry the old name
    # and the new one together.
    #
    # `ansible_host` is the advertise address (the address peers and clients dial);
    # `powerdns_frontend_address` is the VNet private address the scrape dials.
    #
    # The list is CLUSTER-WIDE on purpose. kubeadm applies serverCertSANs to every
    # member's certificate, and a JOINING control plane reads this from the
    # kubeadm-config ConfigMap rather than from its own facts — so a per-node value would
    # render the wrong address on the join path, where this template is written on an
    # existing control plane. Naming every control plane's addresses is correct for every
    # render site.
    #
    # ! Both values are per-host INVENTORY values, not gathered facts: they render
    # ! identically wherever the template runs.
    #
    # WARNING: like every other setting here, this reaches an EXISTING node's certificate
    # only through the reconcile-control-plane-metrics playbook. kubeadm builds
    # certificates at init/join time only.
    serverCertSANs:
{% for control_plane_node in groups['control_plane'] %}
      - "{{ hostvars[control_plane_node]['ansible_host'] }}"
      - "{{ hostvars[control_plane_node]['powerdns_frontend_address'] }}"
{% endfor %}
